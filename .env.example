# Image/source contract
PG_LAKE_REF=01c529dedde75777e09298ae41786d9ae1f337cf
PG_MAJOR=18
PG_LAKE_BUILD_JOBS=2
PG_LAKE_POSTGRES_IMAGE=aetherlake/pg-lake-postgres:01c529d
PGDUCK_IMAGE=aetherlake/pgduck-server:01c529d

# PostgreSQL connection contract
POSTGRES_DB=aetherlake
POSTGRES_USER=aetherlake_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DEMO_UI_PORT=8080
APP_USER=aetherlake_app
APP_PASSWORD=change-me-app-local-only

# S3-compatible persistence contract. For AWS, remove S3_ENDPOINT and use IAM.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=aetherlake
AWS_SECRET_ACCESS_KEY=change-me-minio-local-only
S3_ENDPOINT=http://minio:9000
S3_BUCKET=aetherlake
S3_PREFIX=warehouse
S3_PATH_STYLE=true
S3_USE_SSL=false

# MinIO local-only settings
MINIO_ROOT_USER=aetherlake
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Scheduled jobs (cron syntax)
DELTA_CRON="*/5 * * * *"
VACUUM_CRON="17 * * * *"
SDM_CRON="*/10 * * * *"
DELTA_BATCH_SIZE=10000

# CDF, for `make cdf-deploy cdf-push cdf-parity`. Toolkit variable names, so the Toolkit and
# scripts/cdf-parity.py read the same values. Leave blank to stay purely local.
CDF_CLUSTER=
CDF_PROJECT=
IDP_TENANT_ID=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
